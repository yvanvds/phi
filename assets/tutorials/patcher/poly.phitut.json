{
  "title": "poly — voice allocation",
  "covers": [
    ".poly"
  ],
  "summary": "Give each note a voice from a pool of three, see a note that finds no free voice leave the overflow outlet, and play a three-voice saw on master whose fourth note steals the voice held longest.",
